{
  "name": "navigator",
  "version": "1.3.3",
  "description": "Vim-style modal navigation for the browser with directional spatial search and animated focus indicators",
  "scripts": {
    "dev": "webpack --watch --mode development",
    "build": "webpack --mode production && node scripts/package.js",
    "build:dev": "webpack --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --fix src/ tests/",
    "format": "biome format --write src/ tests/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@vitest/coverage-v8": "^4.1.9",
    "copy-webpack-plugin": "^14.0.0",
    "jsdom": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
